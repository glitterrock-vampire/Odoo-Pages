<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">
    <record id="mail_template_student_fee_reminder" model="mail.template">
      <field name="name">CDT Education: Tuition Reminder</field>
      <field name="model_id" ref="model_cdt_student_fee"/>
      <field name="subject">{{ object.fee_structure_id.company_id.name }} tuition reminder: {{ object.name }}</field>
      <field name="partner_to">{{ object.invoice_partner_id.id }}</field>
      <field name="description">Queued manually or by the opt-in CDT tuition reminder scheduler.</field>
      <field name="body_html" type="html">
<div style="margin: 0; padding: 0;">
  <p style="margin: 0; padding: 0; font-size: 13px;">
    Dear <t t-out="object.invoice_partner_id.name or ''">Parent or guardian</t>,<br/><br/>
    This is a reminder that tuition reference
    <strong t-out="object.name">FEE-000001</strong> for
    <strong t-out="object.student_id.full_name">Student</strong> has an outstanding balance of
    <strong t-out="format_amount(object.balance, object.currency_id)">$0.00</strong>.
    The due date was <span t-field="object.due_date"/>.<br/><br/>
    Please contact CDT Jamaica if you have already made payment or need to discuss arrangements.<br/><br/>
    Best regards,<br/>
    <t t-out="object.fee_structure_id.company_id.name">CDT Jamaica</t>
  </p>
</div>
      </field>
      <field name="auto_delete" eval="False"/>
    </record>

    <record id="ir_cron_queue_student_fee_reminders" model="ir.cron">
      <field name="name">CDT Education: Queue Tuition Reminders</field>
      <field name="model_id" ref="model_cdt_student_fee"/>
      <field name="state">code</field>
      <field name="code">model._cron_queue_fee_reminders()</field>
      <field name="user_id" ref="base.user_root"/>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="active" eval="True"/>
      <field name="priority">10</field>
    </record>
  </data>
</odoo>
