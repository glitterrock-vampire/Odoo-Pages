<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_guardian_consent_list" model="ir.ui.view">
    <field name="name">cdt.guardian.consent.list</field>
    <field name="model">cdt.guardian.consent</field>
    <field name="arch" type="xml">
      <list decoration-success="decision == 'granted'" decoration-warning="decision == 'declined'">
        <field name="name"/>
        <field name="student_id"/>
        <field name="guardian_id"/>
        <field name="consent_type"/>
        <field name="decision" widget="badge"/>
        <field name="signature_name"/>
        <field name="submitted_at"/>
        <field name="source" widget="badge"/>
      </list>
    </field>
  </record>
  <record id="view_guardian_consent_form" model="ir.ui.view">
    <field name="name">cdt.guardian.consent.form</field>
    <field name="model">cdt.guardian.consent</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div>
          <group>
            <group string="Student and Guardian"><field name="student_id"/><field name="guardian_id"/><field name="signature_name"/></group>
            <group string="Decision"><field name="consent_type"/><field name="decision"/><field name="notice_version"/><field name="submitted_at" readonly="1"/><field name="submitted_by_id" readonly="1"/><field name="source" readonly="1"/></group>
          </group>
          <group string="Notes"><field name="notes" nolabel="1"/></group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_guardian_consent" model="ir.actions.act_window">
    <field name="name">Family Consent Records</field>
    <field name="res_model">cdt.guardian.consent</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_student_document_list" model="ir.ui.view">
    <field name="name">cdt.student.document.list</field>
    <field name="model">cdt.student.document</field>
    <field name="arch" type="xml">
      <list decoration-success="verified">
        <field name="submitted_at"/>
        <field name="student_id"/>
        <field name="guardian_id"/>
        <field name="name"/>
        <field name="category" widget="badge"/>
        <field name="verified"/>
        <field name="verified_by_id"/>
      </list>
    </field>
  </record>
  <record id="view_student_document_form" model="ir.ui.view">
    <field name="name">cdt.student.document.form</field>
    <field name="model">cdt.student.document</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group><field name="student_id"/><field name="guardian_id"/><field name="category"/><field name="attachment_id"/></group>
            <group><field name="submitted_at" readonly="1"/><field name="submitted_by_id" readonly="1"/><field name="verified"/><field name="verified_by_id" readonly="1"/><field name="verified_at" readonly="1"/></group>
          </group>
          <group string="Notes"><field name="notes" nolabel="1"/></group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_student_document" model="ir.actions.act_window">
    <field name="name">Student Documents</field>
    <field name="res_model">cdt.student.document</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
