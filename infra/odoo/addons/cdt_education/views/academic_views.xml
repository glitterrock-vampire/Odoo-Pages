<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_education_institution_list" model="ir.ui.view">
    <field name="name">cdt.education.institution.list</field>
    <field name="model">cdt.education.institution</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="company_id"/>
        <field name="current_academic_year_id"/>
        <field name="current_academic_term_id"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="view_education_institution_form" model="ir.ui.view">
    <field name="name">cdt.education.institution.form</field>
    <field name="model">cdt.education.institution</field>
    <field name="arch" type="xml">
      <form string="Education Settings">
        <sheet>
          <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <group string="Institution">
              <field name="code"/>
              <field name="company_id"/>
              <field name="partner_id"/>
              <field name="active" invisible="1"/>
            </group>
            <group string="Academic Defaults">
              <field name="current_academic_year_id"/>
              <field name="current_academic_term_id" domain="[('academic_year_id', '=', current_academic_year_id)]"/>
              <field name="attendance_freeze_date"/>
            </group>
          </group>
          <group string="Student Portal">
            <field name="portal_enabled"/>
            <field name="attendance_by_schedule"/>
            <field name="attendance_notifications_enabled"/>
            <field name="logo" widget="image" class="oe_avatar"/>
          </group>
          <group string="Tuition Reminders">
            <group>
              <field name="automatic_fee_reminders_enabled"/>
              <field name="fee_reminder_template_id" options="{'no_create': True}"/>
            </group>
            <group>
              <field name="fee_reminder_delay_days"/>
              <field name="fee_reminder_repeat_days"/>
            </group>
            <div class="alert alert-info" role="alert" colspan="2">
              Automatic reminders are disabled by default. When enabled, messages are queued for review and delivery by Odoo's outgoing mail scheduler; they are never force-sent by the tuition workflow.
            </div>
          </group>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_education_institution" model="ir.actions.act_window">
    <field name="name">Education Settings</field>
    <field name="res_model">cdt.education.institution</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_academic_year_list" model="ir.ui.view">
    <field name="name">cdt.academic.year.list</field>
    <field name="model">cdt.academic.year</field>
    <field name="arch" type="xml">
      <list decoration-success="state == 'current'" decoration-muted="state == 'closed'">
        <field name="name"/>
        <field name="code"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="state" widget="badge"/>
      </list>
    </field>
  </record>
  <record id="view_academic_year_form" model="ir.ui.view">
    <field name="name">cdt.academic.year.form</field>
    <field name="model">cdt.academic.year</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_set_current" type="object" string="Set Current" class="btn-primary" invisible="state == 'current'"/>
          <button name="action_close" type="object" string="Close" invisible="state == 'closed'"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,current,closed"/>
        </header>
        <sheet>
          <div class="oe_title"><h1><field name="name"/></h1></div>
          <group>
            <field name="code"/>
            <field name="date_start"/>
            <field name="date_end"/>
            <field name="active"/>
          </group>
          <notebook>
            <page string="Academic Terms">
              <field name="term_ids">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="code"/>
                  <field name="date_start"/>
                  <field name="date_end"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_academic_year" model="ir.actions.act_window">
    <field name="name">Academic Years</field>
    <field name="res_model">cdt.academic.year</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="view_academic_term_list" model="ir.ui.view">
    <field name="name">cdt.academic.term.list</field>
    <field name="model">cdt.academic.term</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="code"/>
        <field name="academic_year_id"/>
        <field name="date_start"/>
        <field name="date_end"/>
        <field name="active"/>
      </list>
    </field>
  </record>
  <record id="action_academic_term" model="ir.actions.act_window">
    <field name="name">Academic Terms</field>
    <field name="res_model">cdt.academic.term</field>
    <field name="view_mode">list,form</field>
  </record>

  <record id="action_education_department" model="ir.actions.act_window">
    <field name="name">Departments</field>
    <field name="res_model">cdt.education.department</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_education_room" model="ir.actions.act_window">
    <field name="name">Rooms</field>
    <field name="res_model">cdt.education.room</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_student_category" model="ir.actions.act_window">
    <field name="name">Student Categories</field>
    <field name="res_model">cdt.student.category</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_student_batch" model="ir.actions.act_window">
    <field name="name">Student Batches</field>
    <field name="res_model">cdt.student.batch</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_student_house" model="ir.actions.act_window">
    <field name="name">Student Houses</field>
    <field name="res_model">cdt.student.house</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
