<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_list" model="ir.ui.view">
    <field name="name">cdt.student.list</field>
    <field name="model">cdt.student</field>
    <field name="arch" type="xml">
      <list decoration-muted="status in ('left', 'graduated')" decoration-danger="status == 'suspended'">
        <field name="name"/>
        <field name="full_name"/>
        <field name="current_program_id"/>
        <field name="batch_id"/>
        <field name="email"/>
        <field name="phone"/>
        <field name="status" widget="badge"/>
      </list>
    </field>
  </record>
  <record id="view_student_search" model="ir.ui.view">
    <field name="name">cdt.student.search</field>
    <field name="model">cdt.student</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="full_name"/>
        <field name="email"/>
        <field name="current_program_id"/>
        <field name="batch_id"/>
        <filter string="Active" name="active_students" domain="[('status', '=', 'active')]"/>
        <filter string="Graduated" name="graduated" domain="[('status', '=', 'graduated')]"/>
        <group expand="0" string="Group By">
          <filter string="Program" name="group_program" context="{'group_by': 'current_program_id'}"/>
          <filter string="Batch" name="group_batch" context="{'group_by': 'batch_id'}"/>
          <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
        </group>
      </search>
    </field>
  </record>
  <record id="view_student_form" model="ir.ui.view">
    <field name="name">cdt.student.form</field>
    <field name="model">cdt.student</field>
    <field name="arch" type="xml">
      <form string="Student">
        <header>
          <button name="action_graduate" type="object" string="Graduate" class="btn-primary" invisible="status != 'active'"/>
          <button name="action_mark_left" type="object" string="Mark as Left" invisible="status not in ('active', 'suspended')"/>
          <field name="status" widget="statusbar" statusbar_visible="applicant,active,graduated,left"/>
        </header>
        <sheet>
          <field name="image" widget="image" class="oe_avatar"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" readonly="1"/></h1>
            <h2><field name="full_name" readonly="1"/></h2>
          </div>
          <group>
            <group string="Identity">
              <field name="first_name"/>
              <field name="middle_name"/>
              <field name="last_name"/>
              <field name="date_of_birth"/>
              <field name="gender"/>
              <field name="blood_group"/>
            </group>
            <group string="Academic">
              <field name="joining_date"/>
              <field name="leaving_date" invisible="status not in ('left', 'graduated')"/>
              <field name="current_program_id"/>
              <field name="category_id"/>
              <field name="batch_id"/>
              <field name="house_id"/>
            </group>
          </group>
          <group>
            <group string="Contact">
              <field name="partner_id"/>
              <field name="email" widget="email"/>
              <field name="phone" widget="phone"/>
              <field name="mobile" widget="phone"/>
              <field name="street"/>
              <field name="city"/>
              <field name="country_id"/>
            </group>
            <group string="Portal">
              <field name="portal_user_id"/>
              <field name="legacy_id" groups="cdt_education.group_education_manager"/>
              <field name="active"/>
            </group>
          </group>
          <notebook>
            <page string="Guardians">
              <field name="guardian_line_ids">
                <list editable="bottom">
                  <field name="guardian_id"/>
                  <field name="relationship"/>
                  <field name="emergency_contact"/>
                  <field name="receives_communications"/>
                  <field name="pickup_authorised"/>
                </list>
              </field>
            </page>
            <page string="Siblings"><field name="sibling_ids" widget="many2many_tags"/></page>
            <page string="Enrollments">
              <field name="enrollment_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="program_id"/>
                  <field name="academic_year_id"/>
                  <field name="academic_term_id"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Attendance">
              <field name="attendance_ids" readonly="1">
                <list>
                  <field name="date"/>
                  <field name="student_group_id"/>
                  <field name="course_id"/>
                  <field name="status" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Grades">
              <field name="result_ids" readonly="1">
                <list>
                  <field name="assessment_date"/>
                  <field name="course_id"/>
                  <field name="score"/>
                  <field name="percentage"/>
                  <field name="grade"/>
                  <field name="passed"/>
                </list>
              </field>
            </page>
            <page string="Fees">
              <field name="fee_ids" readonly="1">
                <list>
                  <field name="name"/>
                  <field name="due_date"/>
                  <field name="amount"/>
                  <field name="currency_id" column_invisible="True"/>
                  <field name="balance"/>
                  <field name="state" widget="badge"/>
                </list>
              </field>
            </page>
            <page string="Student Log">
              <field name="log_ids">
                <list>
                  <field name="date"/>
                  <field name="log_type"/>
                  <field name="title"/>
                  <field name="author_id"/>
                  <field name="confidential"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_student" model="ir.actions.act_window">
    <field name="name">Students</field>
    <field name="res_model">cdt.student</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_student_search"/>
  </record>

  <record id="view_guardian_list" model="ir.ui.view">
    <field name="name">cdt.guardian.list</field>
    <field name="model">cdt.guardian</field>
    <field name="arch" type="xml">
      <list><field name="partner_id"/><field name="email"/><field name="phone"/><field name="occupation"/><field name="active"/></list>
    </field>
  </record>
  <record id="view_guardian_form" model="ir.ui.view">
    <field name="name">cdt.guardian.form</field>
    <field name="model">cdt.guardian</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <div class="oe_title"><h1><field name="partner_id"/></h1></div>
          <group>
            <group><field name="email"/><field name="phone"/><field name="mobile"/></group>
            <group><field name="occupation"/><field name="employer"/><field name="active"/></group>
          </group>
          <notebook><page string="Students"><field name="student_line_ids"><list><field name="student_id"/><field name="relationship"/><field name="emergency_contact"/><field name="receives_communications"/></list></field></page></notebook>
        </sheet>
        <chatter/>
      </form>
    </field>
  </record>
  <record id="action_guardian" model="ir.actions.act_window">
    <field name="name">Guardians</field><field name="res_model">cdt.guardian</field><field name="view_mode">list,form</field>
  </record>

  <record id="view_instructor_list" model="ir.ui.view">
    <field name="name">cdt.instructor.list</field><field name="model">cdt.instructor</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="department_id"/><field name="email"/><field name="phone"/><field name="active"/></list></field>
  </record>
  <record id="view_instructor_form" model="ir.ui.view">
    <field name="name">cdt.instructor.form</field><field name="model">cdt.instructor</field>
    <field name="arch" type="xml">
      <form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1><h2><field name="partner_id"/></h2></div><group><group><field name="user_id"/><field name="department_id"/><field name="qualification"/></group><group><field name="email"/><field name="phone"/><field name="active"/></group></group><notebook><page string="Courses"><field name="course_ids" widget="many2many_tags"/></page><page string="Biography"><field name="biography" widget="html"/></page></notebook></sheet><chatter/></form>
    </field>
  </record>
  <record id="action_instructor" model="ir.actions.act_window">
    <field name="name">Instructors</field><field name="res_model">cdt.instructor</field><field name="view_mode">list,form</field>
  </record>

  <record id="action_student_log" model="ir.actions.act_window">
    <field name="name">Student Logs</field><field name="res_model">cdt.student.log</field><field name="view_mode">list,form</field>
  </record>
</odoo>
