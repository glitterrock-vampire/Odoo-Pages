<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_student_attendance_list" model="ir.ui.view">
    <field name="name">cdt.student.attendance.list</field><field name="model">cdt.student.attendance</field>
    <field name="arch" type="xml"><list decoration-success="status == 'present'" decoration-danger="status == 'absent'" decoration-info="status in ('leave', 'excused')"><field name="date"/><field name="student_id"/><field name="student_group_id"/><field name="course_id"/><field name="schedule_id"/><field name="status" widget="badge"/><field name="check_in"/><field name="check_out"/><field name="remarks"/></list></field>
  </record>
  <record id="view_student_attendance_form" model="ir.ui.view">
    <field name="name">cdt.student.attendance.form</field><field name="model">cdt.student.attendance</field>
    <field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="student_id"/></h1></div><group><group><field name="date"/><field name="student_group_id"/><field name="schedule_id"/><field name="course_id" readonly="1"/></group><group><field name="status"/><field name="check_in"/><field name="check_out"/><field name="leave_id" readonly="1"/><field name="remarks"/></group></group></sheet><chatter/></form></field>
  </record>
  <record id="view_student_attendance_pivot" model="ir.ui.view">
    <field name="name">cdt.student.attendance.pivot</field><field name="model">cdt.student.attendance</field>
    <field name="arch" type="xml"><pivot string="Attendance Summary"><field name="student_group_id" type="row"/><field name="status" type="row"/><field name="date" interval="month" type="col"/></pivot></field>
  </record>
  <record id="view_student_attendance_graph" model="ir.ui.view">
    <field name="name">cdt.student.attendance.graph</field><field name="model">cdt.student.attendance</field>
    <field name="arch" type="xml"><graph string="Attendance" type="bar"><field name="student_group_id"/><field name="status"/></graph></field>
  </record>
  <record id="action_student_attendance" model="ir.actions.act_window">
    <field name="name">Student Attendance</field><field name="res_model">cdt.student.attendance</field><field name="view_mode">list,form,pivot,graph</field>
  </record>
  <record id="action_attendance_report" model="ir.actions.act_window">
    <field name="name">Attendance Report</field><field name="res_model">cdt.student.attendance</field><field name="view_mode">pivot,graph,list</field>
  </record>

  <record id="view_student_leave_list" model="ir.ui.view">
    <field name="name">cdt.student.leave.list</field><field name="model">cdt.student.leave</field>
    <field name="arch" type="xml"><list decoration-success="state == 'approved'" decoration-danger="state == 'rejected'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="student_id"/><field name="date_from"/><field name="date_to"/><field name="student_group_id"/><field name="mark_present"/><field name="state" widget="badge"/></list></field>
  </record>
  <record id="view_student_leave_form" model="ir.ui.view">
    <field name="name">cdt.student.leave.form</field><field name="model">cdt.student.leave</field>
    <field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="btn-primary" invisible="state != 'submitted'"/><button name="action_reject" type="object" string="Reject" invisible="state != 'submitted'"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('cancelled', 'rejected')"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,rejected"/></header><sheet><div class="oe_title"><label for="name"/><h1><field name="name" readonly="1"/></h1></div><group><group><field name="student_id"/><field name="student_group_id"/><field name="date_from"/><field name="date_to"/></group><group><field name="mark_present"/><field name="supporting_document_id"/></group></group><group string="Reason"><field name="reason" nolabel="1"/></group><notebook><page string="Attendance Created"><field name="attendance_ids" readonly="1"><list><field name="date"/><field name="student_group_id"/><field name="status"/><field name="remarks"/></list></field></page></notebook></sheet><chatter/></form></field>
  </record>
  <record id="action_student_leave" model="ir.actions.act_window">
    <field name="name">Leave Applications</field><field name="res_model">cdt.student.leave</field><field name="view_mode">list,form</field>
  </record>

  <record id="view_attendance_bulk_wizard_form" model="ir.ui.view">
    <field name="name">cdt.attendance.bulk.wizard.form</field><field name="model">cdt.attendance.bulk.wizard</field>
    <field name="arch" type="xml"><form string="Bulk Attendance"><group><field name="student_group_id"/><field name="date"/><field name="schedule_id" domain="[('student_group_id', '=', student_group_id)]"/><field name="default_status"/></group><footer><button name="action_mark_attendance" type="object" string="Mark Attendance" class="btn-primary"/><button string="Cancel" special="cancel"/></footer></form></field>
  </record>
  <record id="action_attendance_bulk_wizard" model="ir.actions.act_window">
    <field name="name">Bulk Attendance Tool</field><field name="res_model">cdt.attendance.bulk.wizard</field><field name="view_mode">form</field><field name="target">new</field>
  </record>
</odoo>
