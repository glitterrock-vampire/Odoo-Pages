<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
  <record id="ir_cron_sync_marketing_audience" model="ir.cron">
    <field name="name">CDT: Sync Mailchimp audience into Odoo</field>
    <field name="model_id" ref="model_cdt_site_setting"/>
    <field name="state">code</field>
    <field name="code">model.with_context(cron_mode=True).action_sync_marketing_audience()</field>
    <field name="user_id" ref="base.user_admin"/>
    <field name="interval_number">1</field>
    <field name="interval_type">hours</field>
    <field name="nextcall" eval="(DateTime.now() + relativedelta(hours=1)).strftime('%Y-%m-%d %H:%M:%S')"/>
    <field name="active">True</field>
  </record>
</odoo>
